{
  "name": "templatebsi",
  "version": "1.2.0",
  "description": "Template & Generator Otomatis Jurnal Ilmiah SINTA 1-6 (Word & Typst) + Laporan/Proposal PKL UBSI Prodi Teknologi Informasi (S1)",
  "main": "lib.typ",
  "files": [
    "bin/",
    "lib.typ",
    "sinta.typ",
    "typst.toml",
    "template/",
    "presets/",
    "scripts/",
    "generate_sinta_journal_docx.py",
    ".agents/skills/laporan-generator/",
    ".agents/rules/sinta-journal-prompt.md",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "create-templatebsi": "./bin/cli.js",
    "templatebsi": "./bin/cli.js",
    "laporan-generator": "./bin/cli.js",
    "sinta-agent": "./bin/sinta-agent.js",
    "jurnal-sinta": "./bin/sinta-agent.js"
  },
  "scripts": {
    "test": "node scripts/test.js",
    "test:installer": "node scripts/test_installer.js",
    "test:sinta": "uv run scripts/test_sinta.py",
    "test:all": "node scripts/test.js && node scripts/test_installer.js && uv run scripts/test_sinta.py",
    "create": "node bin/cli.js",
    "sinta": "uv run generate_sinta_journal_docx.py",
    "sinta:showcase": "uv run generate_sinta_journal_docx.py --generate-showcase contoh-template-ai",
    "sinta:inspect": "uv run generate_sinta_journal_docx.py --inspect-docx",
    "agent:install": "uv run scripts/install_agent_skills.py",
    "agent:install:node": "node bin/install-skill.js install",
    "agent:status": "node bin/install-skill.js status",
    "diagrams": "uv run scripts/generate_diagrams.py",
    "pkl:update": "uv run --with python-docx python scripts/update_docx_script.py"
  },
  "keywords": [
    "typst",
    "ubsi",
    "pkl",
    "proposal",
    "sinta",
    "jurnal-ilmiah",
    "kilocode",
    "opencode",
    "freebuff",
    "antigravity",
    "template",
    "skripsi",
    "teknologi-informasi"
  ],
  "author": "fatidaprilian",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sutannn13/laporan-generator.git"
  }
}
